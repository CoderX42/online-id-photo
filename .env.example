# 微信支付（Native 扫码支付）
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=
# 商户号
WECHAT_MCHID=
# 公众号/小程序 AppID
WECHAT_APPID=
# API v3 密钥（在商户平台设置）
WECHAT_API_V3_KEY=
# 商户证书序列号
WECHAT_SERIAL_NO=
# 商户私钥（PEM 格式，多行用 \n 连接或直接粘贴）
WECHAT_PRIVATE_KEY=
# 微信支付平台证书公钥（用于验签）
WECHAT_PLATFORM_PUBLIC_KEY=
WECHAT_PLATFORM_SERIAL_NO=
# 可选；默认使用 NEXT_PUBLIC_SITE_URL + /api/pay/webhook
WECHAT_NOTIFY_URL=
